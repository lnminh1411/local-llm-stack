# Central config for the whole stack. Copy to config.env (git-ignored) and edit.
# Format: KEY=VALUE, one per line, '#' starts a comment, no quotes. Blank value = use the built-in default.
# Found via the LOCALAI_CONFIG environment variable (full path), else config.env next to the repo root.
# Read by: Service/ (Local AI Host), Launcher/*.ps1, Bridge/*.py, shared/config.js (OpenClaw plugins), ExecGuard/*.py.

# --- Folders ---------------------------------------------------------------------------------
# This repo checkout.
LOCALAI_HOME=C:\Local LLM
# The Launcher folder; the service runs llama-wake.py and Start-LocalAI.ps1 from here.
SCRIPTS_DIR=C:\Local LLM\Launcher
# Folders searched for the model files, ';'-separated. Blank = <every fixed drive>:\ModelCache.
MODEL_DIRS=C:\ModelCache
# Official llama.cpp Windows CUDA release: llama-bXXXXX-bin-win-cuda-12.4-x64.zip + cudart-llama-bin-win-cuda-12.4-x64.zip
# extracted into one folder (llama-server.exe, ggml-cuda.dll, cudart). Blank = %LOCALAPPDATA%\Programs\llama.cpp.
LLAMA_DIR=
# Logs. Blank = %USERPROFILE%\.openclaw\logs.
LOG_DIR=
# python.exe for the wake proxy and the ExecGuard helpers. Blank = first python on PATH (set it: a service may not see your PATH).
PYTHON=

# --- Model -----------------------------------------------------------------------------------
MODEL_FILE=occamy-1.0-abliterated-FIT-QUALITY-17G-IQ4_XS.gguf
# Vision projector. Blank = text only.
MMPROJ_FILE=mmproj-occamy-1.0-abliterated-Q4_0.gguf
MODEL_ALIAS=occamy-1.0-fit-quality
# Blank = the template embedded in the GGUF.
CHAT_TEMPLATE_FILE=
CONTEXT=131072
HEAVY_CONTEXT=262144
IDLE_UNLOAD_MINUTES=20
# occamy | swift
SAMPLING=occamy
# 0 = no speculative decoding
MTP_DRAFT=0
FIT_TARGET=100
IMAGE_MAX_TOKENS=768
MMPROJ_GPU=true
KEEP_AWAKE=true

# --- Hardware --------------------------------------------------------------------------------
# nvidia-smi -L
GPU_UUID=GPU-00000000-0000-0000-0000-000000000000
# Hex affinity mask for llama-server. Blank or PIN_ECORES=false = no pinning.
ECORE_MASK=0x3FC3C
PIN_ECORES=true

# --- Network (all localhost) -----------------------------------------------------------------
HOST=127.0.0.1
# What clients use (the wake proxy)
PROXY_PORT=8080
# The real llama-server
LLAMA_PORT=8081
# OpenClaw gateway
GATEWAY_PORT=18789

# --- Local AI Host service (Service/) -----------------------------------------------------------
# What it supervises besides the wake proxy.
SUPERVISE_GATEWAY=true
SUPERVISE_WEBUI=true
# Open WebUI folder. Blank = LOCALAI_HOME\WebUI.
WEBUI_DIR=
# P-core affinity for Open WebUI + its auth proxy (keeps them off the model's E-cores).
PCORE_MASK=0xC03C3
